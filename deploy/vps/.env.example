# Production environment for VPS deployment.
# Copy to `.env` and fill in real secrets. Never commit `.env`.

# ---------------------------------------------------------------------
# Backend image — set to a specific tag when pinning a release
# ---------------------------------------------------------------------
BACKEND_IMAGE=ghcr.io/abobateam-production/junto-backend:main

# ---------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------
SECRET_KEY=<generate with: python -c "import secrets; print(secrets.token_urlsafe(64))">
ALLOWED_HOSTS=api.juntoapp.tech,livekit.juntoapp.tech
CSRF_TRUSTED_ORIGINS=https://app.juntoapp.tech,https://juntoapp.tech
CORS_ALLOWED_ORIGINS=https://app.juntoapp.tech,https://juntoapp.tech

# ---------------------------------------------------------------------
# Postgres — `db` container
# ---------------------------------------------------------------------
POSTGRES_DB=watchparty
POSTGRES_USER=junto
POSTGRES_PASSWORD=<generate with: openssl rand -base64 24>

# ---------------------------------------------------------------------
# LiveKit — used both by backend (token signing) and the LiveKit container
# ---------------------------------------------------------------------
LIVEKIT_API_KEY=<openssl rand -hex 16>
LIVEKIT_API_SECRET=<openssl rand -hex 32>
# Public WSS URL — must match nginx vhost / TURN config
LIVEKIT_WS_URL=wss://livekit.juntoapp.tech

# ---------------------------------------------------------------------
# TorrServer — public URL for streaming. /torrserver/ proxied via nginx.
# ---------------------------------------------------------------------
TORRSERVER_PUBLIC_URL=https://api.juntoapp.tech/torrserver

# ---------------------------------------------------------------------
# Jacred — torrent search. External mirror jac.red works without auth.
# ---------------------------------------------------------------------
JACRED_URL=https://jac.red
JACRED_APIKEY=

# ---------------------------------------------------------------------
# Firebase Cloud Messaging — drop the service-account JSON to ./firebase/
# and reference it here. Empty value = push notifications disabled.
# ---------------------------------------------------------------------
FIREBASE_CREDENTIALS_PATH=/firebase/junto-fcm.json

# ---------------------------------------------------------------------
# TMDb — via your CF Worker, not direct
# ---------------------------------------------------------------------
TMDB_API_KEY=
TMDB_PROXY_BASE=https://tmdb-proxy.alexfake95.workers.dev
TMDB_PROXY_SECRET=
TMDB_IMAGE_BASE=https://tmdb-images-proxy.alexfake95.workers.dev

# ---------------------------------------------------------------------
# Grafana — UI at https://grafana.juntoapp.tech (issue cert before first up)
# ---------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<openssl rand -base64 24>
